<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fluvi_orb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:foregroundGravity="center">

    <!--
      This is the one geometric clip for every ViewFlipper layer. On Android
      12+ the provider makes this container physically square and sets a
      half-side outline radius through RemoteViews, giving the launcher one
      quiet circular edge for both the outgoing and incoming bitmaps.
    -->
    <FrameLayout
        android:id="@+id/fluvi_orb_circle_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/fluvi_orb_circle_clip"
        android:clipChildren="true"
        android:clipToOutline="true">

        <!--
          RemoteViews cannot change an Animation duration after inflation.
          The provider reveals one of these stock ViewFlippers, adds all
          frames in one update, and the launcher owns the loop thereafter.
          In ViewAnimator the incoming child is shown after the outgoing
          child; its alpha animation therefore composes on top instead of
          exposing the transparent root between frames.
        -->
        <ViewFlipper
            android:id="@+id/fluvi_orb_frame_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="1000"
            android:contentDescription="@null" />

        <ViewFlipper
            android:id="@+id/fluvi_orb_frame_flipper_40"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="40"
            android:inAnimation="@anim/fluvi_orb_fade_in_40"
            android:outAnimation="@anim/fluvi_orb_fade_out_40"
            android:visibility="gone"
            android:contentDescription="@null" />

        <ViewFlipper
            android:id="@+id/fluvi_orb_frame_flipper_60"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
