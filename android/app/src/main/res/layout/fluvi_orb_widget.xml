<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fluvi_orb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:foregroundGravity="center">

    <!--
      ViewFlipper is one of the platform RemoteViews collection-safe view
      types.  The provider installs a finite image sequence in one update; the
      launcher owns the subsequent local loop.  No provider timer or per-frame
      IPC is involved.
    -->
    <ViewFlipper
        android:id="@+id/fluvi_orb_frame_flipper"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:autoStart="true"
        android:flipInterval="80"
        android:contentDescription="@null" />
</FrameLayout>
