<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/fluvi_orb_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:foregroundGravity="center">

    <!-- The provider sets this square to the current usable short side. The
         launcher clips every animation layer together, so the edge does not
         move or flash while complete frames change. -->
    <FrameLayout
        android:id="@+id/fluvi_orb_circle_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:background="@drawable/fluvi_orb_circle_clip"
        android:clipChildren="true"
        android:clipToOutline="true">

        <ViewFlipper
            android:id="@+id/fluvi_orb_frame_flipper"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:animateFirstView="false"
            android:flipInterval="33"
            android:contentDescription="@null" />
    </FrameLayout>
</FrameLayout>
