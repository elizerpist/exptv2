<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Required by the Flutter tool to connect to the development VM service. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <application>
        <!-- Synthetic static ORB for an owner-selected lockscreen host trial. -->
        <receiver
            android:name=".widget.trial.FluviOrbLockscreenTrialProvider"
            android:exported="true"
            android:label="@string/fluvi_orb_lockscreen_trial_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.appwidget.action.APPWIDGET_OPTIONS_CHANGED" />
                <action android:name="android.appwidget.action.APPWIDGET_RESTORED" />
            </intent-filter>
            <meta-data android:name="android.appwidget.provider"
                android:resource="@xml/fluvi_orb_lockscreen_trial_info" />
        </receiver>
        <!-- Same-package, separate-process R35 demo fixture. No profile/release entry. -->
        <service android:name="com.fluvi.app.lockscreen.host.R35DebugResidentService"
            android:process=":r35_receiver" android:exported="false" />
        <!-- Target-APK-only host for the API-35 instrumentation smoke. The
             test runner can only start activities installed with the target
             application; this debug declaration never enters a release APK. -->
        <activity
            android:name="com.fluvi.app.lockscreen.material.KeyguardMaterialTestActivity"
            android:exported="false"
            android:hardwareAccelerated="true"
            android:theme="@style/NormalTheme" />
    </application>
</manifest>
