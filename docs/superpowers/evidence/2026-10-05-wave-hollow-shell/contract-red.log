              '      if (datum.value > values[highestIndex].value) highestIndex = index;\n'
              '      final x = values.length == 1\n'
              '          ? plot.center.dx\n'
              '          : plot.left + plot.width * index / (values.length - 1);\n'
              '      final normalized = (datum.value / maximum).clamp(0.0, 1.0).toDouble();\n'
              '      offsets.add(Offset(x, baseline - normalized * drawableHeight));\n'
              '    }\n'
              '    final controls = offsets.length == 1\n'
              '        ? <Offset>[\n'
              '            Offset(plot.left, offsets.first.dy),\n'
              '            Offset(plot.right, offsets.first.dy),\n'
              '          ]\n'
              '        : offsets;\n'
              '    final samples = _boundedSamples(controls);\n'
              '    final ridgePath = _pathFor(samples);\n'
              '    final feet = _surfaceFeet(samples, plot);\n'
              '    final surfacePath = _closedPath(samples, feet);\n'
              '    final layerCount = (plot.height / 4).round().clamp(8, 24);\n'
              '    final depths = List<FluviTopographicWaveDepthLayer>.generate(layerCount, (\n'
              '      index,\n'
              '    ) {\n'
              '      final depth = index / (layerCount - 1);\n'
              '      final flattened = List<Offset>.generate(\n'
              '        samples.length,\n'
              '        (sampleIndex) => Offset(\n'
              '          samples[sampleIndex].dx,\n'
              '          _lerp(samples[sampleIndex].dy, feet[sampleIndex].dy, depth * .82),\n'
              '        ),\n'
              '        growable: false,\n'
              '      );\n'
              '      return FluviTopographicWaveDepthLayer(\n'
              '        depth: depth,\n'
              '        path: _pathFor(flattened),\n'
              '        opacity: .11 * math.pow(1 - depth, 1.3).toDouble(),\n'
              '      );\n'
              '    }, growable: false);\n'
              '    final normalizedMean =\n'
              '        values.fold<double>(0, (sum, datum) => sum + datum.value / maximum) /\n'
              '        values.length;\n'
              '    final volatility = _volatility(values, maximum);\n'
              '    return FluviTopographicWaveTerrain._(\n'
              '      size: size,\n'
              '      plot: plot,\n'
              '      ridgeSamples: List<Offset>.unmodifiable(samples),\n'
              '      ridgePath: ridgePath,\n'
              '      surfaceFootSamples: List<Offset>.unmodifiable(feet),\n'
              '      surfacePath: surfacePath,\n'
              '      surfaceMesh: _surfaceMesh(samples, feet, plot),\n'
              '      areaPath: surfacePath,\n'
              '      depthLayers: List<FluviTopographicWaveDepthLayer>.unmodifiable(depths),\n'
              '      atmospheres: List<FluviTopographicWaveAtmosphericLayer>.unmodifiable(\n'
              '        _atmospheres(\n'
              '          plot: plot,\n'
              '          normalizedMean: normalizedMean,\n'
              '          volatility: volatility,\n'
              '        ),\n'
              '      ),\n'
              '      dataOffsets: List<Offset>.unmodifiable(offsets),\n'
              '      highestIndex: highestIndex,\n'
              '      values: List<FluviTopographicWaveDatum>.unmodifiable(values),\n'
              '    );\n'
              '  }\n'
              '\n'
              '  static List<Offset> _surfaceFeet(List<Offset> ridge, Rect plot) =>\n'
              '      List<Offset>.generate(ridge.length, (index) {\n'
              '        final point = ridge[index];\n'
              '        final x = (point.dx - plot.left) / plot.width;\n'
              '        // A calm material shore, not a displaced copy of financial peaks.\n'
              '        // Its highest point is below the genuine zero baseline at every x.\n'
              '        return Offset(\n'
              '          point.dx,\n'
              '          plot.bottom -\n'
              '              plot.height * (.04 + .025 * math.cos(x * math.pi * 2 - .4)),\n'
              '        );\n'
              '      }, growable: false);\n'
              '\n'
              '  static double _slopeAt(List<Offset> samples, int index) {\n'
              '    if (samples.length < 2) return 0;\n'
              '    final previous = samples[math.max(0, index - 1)];\n'
              '    final next = samples[math.min(samples.length - 1, index + 1)];\n'
              '    final dx = next.dx - previous.dx;\n'
              '    return dx.abs() < .001 ? 0 : (next.dy - previous.dy) / dx;\n'
              '  }\n'
              '\n'
              '  static double _lerp(double start, double end, double amount) =>\n'
              '      start + (end - start) * amount.clamp(0.0, 1.0);\n'
              '\n'
              '  static Path _closedPath(List<Offset> ridge, List<Offset> feet) {\n'
              '    final path = _pathFor(ridge);\n'
              '    for (final point in feet.reversed) {\n'
              '      path.lineTo(point.dx, point.dy);\n'
              '    }\n'
              '    return path..close();\n'
              '  }\n'
              '\n'
              '  static ui.Vertices? _surfaceMesh(\n'
              '    List<Offset> ridge,\n'
              '    List<Offset> feet,\n'
              '    Rect plot, {\n'
              '    double opacity = 1,\n'
              '    double distance = 0,\n'
              '  }) {\n'
              '    if (ridge.length < 2 || ridge.length != feet.length) return null;\n'
              '    const rows = 24;\n'
              '    final columns = ridge.length;\n'
              '    final positions = Float32List(columns * rows * 2);\n'
              '    final colors = Int32List(columns * rows);\n'
              '    for (var column = 0; column < columns; column += 1) {\n'
              '      final slope = _slopeAt(ridge, column);\n'
              '      final footSlope = _slopeAt(feet, column);\n'
              '      for (var row = 0; row < rows; row += 1) {\n'
              '        final depth = row / (rows - 1);\n'
              '        final vertex = column * rows + row;\n'
              '        positions[vertex * 2] = ridge[column].dx;\n'
              '        positions[vertex * 2 + 1] = _lerp(\n'
              '          ridge[column].dy,\n'
              '          feet[column].dy,\n'
              '          depth,\n'
              '        );\n'
              '        final color = _FluviWaveMaterial.color(depth, slope, footSlope);\n'
              '        colors[vertex] = Color.lerp(\n'
              '          color,\n'
              '          FluviTopographicWavePalette.periwinkle.withValues(alpha: color.a),\n'
              '          distance,\n'
              '        )!.withValues(alpha: color.a * opacity).toARGB32();\n'
              '      }\n'
              '    }\n'
              '    final indices = Uint16List((columns - 1) * (rows - 1) * 6);\n'
              '    var write = 0;\n'
              '    for (var column = 0; column < columns - 1; column += 1) {\n'
              '      for (var row = 0; row < rows - 1; row += 1) {\n'
              '        final topLeft = column * rows + row;\n'
              '        final topRight = (column + 1) * rows + row;\n'
              '        final bottomLeft = topLeft + 1;\n'
              '        final bottomRight = topRight + 1;\n'
              '        indices[write++] = topLeft;\n'
              '        indices[write++] = topRight;\n'
              '        indices[write++] = bottomLeft;\n'
              '        indices[write++] = topRight;\n'
              '        indices[write++] = bottomRight;\n'
              '        indices[write++] = bottomLeft;\n'
              '      }\n'
              '    }\n'
              '    return ui.Vertices.raw(\n'
              '      ui.VertexMode.triangles,\n'
              '      positions,\n'
              '      colors: colors,\n'
              '      indices: indices,\n'
              '    );\n'
              '  }\n'
              '\n'
              '  static double _volatility(\n'
              '    List<FluviTopographicWaveDatum> values,\n'
              '    int maximum,\n'
              '  ) {\n'
              '    if (maximum <= 0 || values.length < 2) return 0;\n'
              '    var movement = 0.0;\n'
              '    for (var index = 1; index < values.length; index += 1) {\n'
              '      movement +=\n'
              '          (values[index].value - values[index - 1].value).abs() / maximum;\n'
              '    }\n'
              '    return (movement / (values.length - 1)).clamp(0.0, 1.0).toDouble();\n'
              '  }\n'
              '\n'
              '  static List<FluviTopographicWaveAtmosphericLayer> _atmospheres({\n'
              '    required Rect plot,\n'
              '    required double normalizedMean,\n'
              '    required double volatility,\n'
              '  }) {\n'
              '    const profiles = <List<double>>[\n'
              '      [.90, .78, .47, .66, .70, .28, .62, .72, .44, .68, .92],\n'
              '      [.94, .82, .62, .74, .39, .72, .77, .55, .67, .43, .94],\n'
              '      [.92, .88, .80, .86, .90, .83, .89, .91, .82, .87, .92],\n'
              '    ];\n'
              '    final empty = normalizedMean == 0 && volatility == 0;\n'
              '    return List<FluviTopographicWaveAtmosphericLayer>.generate(\n'
              '      profiles.length,\n'
              '      (index) {\n'
              '        final controls = <Offset>[\n'
              '          for (var point = 0; point < profiles[index].length; point += 1)\n'
              '            Offset(\n'
              '              plot.left + plot.width * point / (profiles[index].length - 1),\n'
              '              plot.top +\n'
              '                  plot.height *\n'
              '                      (empty\n'
              '                          ? .82 + profiles[index][point] * .12\n'
              '                          : profiles[index][point]),\n'
              '            ),\n'
              '        ];\n'
              '        final sampled = _boundedSamples(controls, samplesPerSegment: 18);\n'
              '        final path = _pathFor(sampled);\n'
              '        final feet = _surfaceFeet(sampled, plot);\n'
              '        final fillPath = _closedPath(sampled, feet);\n'
              '        final foreground = index == profiles.length - 1;\n'
              '        final opacity = empty ? .13 : (foreground ? .65 : .50 + index * .12);\n'
              '        return FluviTopographicWaveAtmosphericLayer(\n'
              '          path: path,\n'
              '          fillPath: fillPath,\n'
              '          surfaceBounds: fillPath.getBounds(),\n'
              '          color: FluviTopographicWavePalette.periwinkle,\n'
              '          opacity: opacity,\n'
              '          blurSigma: 0,\n'
              '          foreground: foreground,\n'
              '          mesh: _surfaceMesh(\n'
              '            sampled,\n'
              '            feet,\n'
              '            plot,\n'
              '            opacity: opacity,\n'
              '            distance: foreground ? .88 : .25 - index * .12,\n'
              '          ),\n'
              '        );\n'
              '      },\n'
              '      growable: false,\n'
              '    );\n'
              '  }\n'
              '\n'
              '  static List<Offset> _boundedSamples(\n'
              '    List<Offset> controls, {\n'
              '    int samplesPerSegment = 14,\n'
              '  }) {\n'
              '    if (controls.isEmpty) return const <Offset>[];\n'
              '    if (controls.length == 1) return List<Offset>.of(controls);\n'
              '    final samples = <Offset>[];\n'
              '    final segments =\n'
              '        fluviBoundedMonotoneSegments<(Offset, Offset, Offset, Offset)>(\n'
              '          controls,\n'
              '          controlSpan: .48,\n'
              '          create:\n'
              '              ({\n'
              '                required start,\n'
              '                required controlOne,\n'
              '                required controlTwo,\n'
              '                required end,\n'
              '                required isLinear,\n'
              '              }) => (start, controlOne, controlTwo, end),\n'
              '        );\n'
              '    for (final (start, controlOne, controlTwo, end) in segments) {\n'
              '      for (var sample = 0; sample < samplesPerSegment; sample += 1) {\n'
              '        final t = sample / samplesPerSegment;\n'
              '        final q = 1 - t;\n'
              '        samples.add(\n'
              '          Offset(\n'
              '            q * q * q * start.dx +\n'
              '                3 * q * q * t * controlOne.dx +\n'
              '                3 * q * t * t * controlTwo.dx +\n'
              '                t * t * t * end.dx,\n'
              '            start.dy == end.dy\n'
              '                ? start.dy\n'
              '                : q * q * q * start.dy +\n'
              '                      3 * q * q * t * controlOne.dy +\n'
              '                      3 * q * t * t * controlTwo.dy +\n'
              '                      t * t * t * end.dy,\n'
              '          ),\n'
              '        );\n'
              '      }\n'
              '    }\n'
              '    samples.add(controls.last);\n'
              '    return samples;\n'
              '  }\n'
              '\n'
              '  static Path _pathFor(List<Offset> points) {\n'
              '    final path = Path();\n'
              '    if (points.isEmpty) return path;\n'
              '    path.moveTo(points.first.dx, points.first.dy);\n'
              '    for (final point in points.skip(1)) {\n'
              '      path.lineTo(point.dx, point.dy);\n'
              '    }\n'
              '    return path;\n'
              '  }\n'
              '}\n'
              '\n'
              'final class _FluviTopographicWaveGeometryCache {\n'
              '  _FluviTopographicWaveCacheKey? _key;\n'
              '  FluviTopographicWaveTerrain? _terrain;\n'
              '\n'
              '  FluviTopographicWaveTerrain resolve({\n'
              '    required List<FluviTopographicWaveDatum> values,\n'
              '    required Size size,\n'
              '  }) {\n'
              '    final key = _FluviTopographicWaveCacheKey(values: values, size: size);\n'
              '    if (key == _key && _terrain != null) return _terrain!;\n'
              '    _key = key;\n'
              '    return _terrain = FluviTopographicWaveTerrain.resolve(\n'
              '      values: values,\n'
              '      size: size,\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              '@immutable\n'
              'final class _FluviTopographicWaveCacheKey {\n'
              '  _FluviTopographicWaveCacheKey({\n'
              '    required List<FluviTopographicWaveDatum> values,\n'
              '    required this.size,\n'
              '  }) : values = List<FluviTopographicWaveDatum>.unmodifiable(values);\n'
              '\n'
              '  final List<FluviTopographicWaveDatum> values;\n'
              '  final Size size;\n'
              '\n'
              '  @override\n'
              '  bool operator ==(Object other) =>\n'
              '      other is _FluviTopographicWaveCacheKey &&\n'
              '      other.size == size &&\n'
              '      listEquals(other.values, values);\n'
              '\n'
              '  @override\n'
              '  int get hashCode => Object.hash(size, Object.hashAll(values));\n'
              '}\n'
              '\n'
              'final class _FluviTopographicWavePainter extends CustomPainter {\n'
              '  const _FluviTopographicWavePainter({\n'
              '    required this.terrain,\n'
              '    required this.style,\n'
              '    required this.surfaceShader,\n'
              '    required this.curveTexture,\n'
              '    required this.selectedIndex,\n'
              '    required this.tooltipForValue,\n'
              '    required this.metrics,\n'
              '    required this.debug,\n'
              '    required this.fontFamily,\n'
              '  });\n'
              '\n'
              '  final FluviTopographicWaveTerrain terrain;\n'
              '  final FluviTopographicWaveStyle style;\n'
              '  final ui.FragmentShader? surfaceShader;\n'
              '  final ui.Image? curveTexture;\n'
              '  final int? selectedIndex;\n'
              '  final String Function(int value) tooltipForValue;\n'
              '  final FluviWaveRenderMetrics metrics;\n'
              '  final FluviWaveDebugScope? debug;\n'
              '  final String? fontFamily;\n'
              '\n'
              '  @override\n'
              '  void paint(Canvas canvas, Size size) {\n'
              '    if (size.isEmpty) return;\n'
              '    canvas.save();\n'
              '    canvas.clipRRect(\n'
              '      RRect.fromRectAndRadius(Offset.zero & size, const Radius.circular(14)),\n'
              '    );\n'
              '    metrics.markerBounds = null;\n'
              '    metrics.tooltipBounds = null;\n'
              '    metrics.selectedIndex = null;\n'
              '    metrics.selectedKey = null;\n'
              '    metrics.selectedValueMinor = null;\n'
              '    metrics.tooltipText = null;\n'
              '    if (!(debug?.opaqueBody ?? false) &&\n'
              '        !(debug?.materialOnly ?? false) &&\n'
              '        (debug?.atmosphere ?? true)) {\n'
              '      _drawAtmospheres(canvas, foreground: false);\n'
              '    }\n'
              '    if (terrain.ridgeSamples.isEmpty) {\n'
              '      if (debug?.atmosphere ?? true) _drawAtmospheres(canvas, foreground: true);\n'
              '      metrics.recordPaint(terrain, \'empty\');\n'
              '      debug?.onPaint?.call(metrics);\n'
              '      canvas.restore();\n'
              '      return;\n'
              '    }\n'
              '    if (debug?.opaqueBody ?? false) {\n'
              '      canvas.drawPath(\n'
              '        terrain.surfacePath,\n'
              '        Paint()..color = const Color(0xff9682f2),\n'
              '      );\n'
              '      metrics.recordPaint(terrain, \'opaque-diagnostic\');\n'
              '    } else {\n'
              '      if (!(debug?.materialOnly ?? false)) _drawGuides(canvas);\n'
              '      _drawSurface(canvas);\n'
              '      if (!(debug?.materialOnly ?? false)) {\n'
              '        if (debug?.atmosphere ?? true) {\n'
              '          _drawAtmospheres(canvas, foreground: true);\n'
              '        }\n'
              '        if (debug?.contours ?? true) _drawContours(canvas);\n'
              '        _drawRidge(canvas);\n'
              '        _drawMarkerAndTooltip(canvas, size);\n'
              '      }\n'
              '      metrics.recordPaint(\n'
              '        terrain,\n'
              '        surfaceShader != null && curveTexture != null ? \'shader\' : \'mesh\',\n'
              '      );\n'
              '    }\n'
              '    if (debug?.bounds ?? false) {\n'
              '      canvas.drawRect(\n'
              '        (Offset.zero & size).deflate(.5),\n'
              '        Paint()\n'
              '          ..color = Colors.red\n'
              '          ..style = PaintingStyle.stroke,\n'
              '      );\n'
              '      canvas.drawRect(\n'
              '        terrain.plot,\n'
              '        Paint()\n'
              '          ..color = Colors.blue\n'
              '          ..style = PaintingStyle.stroke,\n'
              '      );\n'
              '      canvas.drawLine(\n'
              '        Offset(terrain.plot.left, terrain.financialBaseline),\n'
              '        Offset(terrain.plot.right, terrain.financialBaseline),\n'
              '        Paint()..color = Colors.orange,\n'
              '      );\n'
              '      canvas.drawPath(\n'
              '        terrain.ridgePath,\n'
              '        Paint()\n'
              '          ..color = Colors.white\n'
              '          ..style = PaintingStyle.stroke,\n'
              '      );\n'
              '      canvas.drawPath(\n'
              '        FluviTopographicWaveTerrain._pathFor(terrain.surfaceFootSamples),\n'
              '        Paint()\n'
              '          ..color = Colors.green\n'
              '          ..style = PaintingStyle.stroke,\n'
              '      );\n'
              '    }\n'
              '    debug?.onPaint?.call(metrics);\n'
              '    canvas.restore();\n'
              '  }\n'
              '\n'
              '  void _drawAtmospheres(Canvas canvas, {required bool foreground}) {\n'
              '    for (final wave in terrain.atmospheres) {\n'
              '      if (wave.foreground != foreground) continue;\n'
              '      if (wave.mesh != null) {\n'
              '        canvas.drawVertices(\n'
              '          wave.mesh!,\n'
              '          BlendMode.srcOver,\n'
              '          Paint()..isAntiAlias = true,\n'
              '        );\n'
              '      }\n'
              '      canvas.drawPath(\n'
              '        wave.path,\n'
              '        Paint()\n'
              '          ..color = FluviTopographicWavePalette.pearl.withValues(\n'
              '            alpha: wave.opacity * (foreground ? .16 : .45),\n'
              '          )\n'
              '          ..style = PaintingStyle.stroke\n'
              '          ..strokeWidth = .5\n'
              '          ..strokeCap = StrokeCap.round\n'
              '          ..strokeJoin = StrokeJoin.round,\n'
              '      );\n'
              '    }\n'
              '  }\n'
              '\n'
              '  void _drawGuides(Canvas canvas) {\n'
              '    final paint = Paint()\n'
              '      ..color = const Color(0xffdce5f5).withValues(alpha: .56)\n'
              '      ..strokeWidth = .7\n'
              '      ..style = PaintingStyle.stroke;\n'
              '    const guideCount = 7;\n'
              '    for (var index = 0; index < guideCount; index += 1) {\n'
              '      final x =\n'
              '          terrain.plot.left + terrain.plot.width * index / (guideCount - 1);\n'
              '      for (var y = terrain.plot.top; y < terrain.plot.bottom; y += 7) {\n'
              '        canvas.drawLine(\n'
              '          Offset(x, y),\n'
              '          Offset(x, math.min(y + 3, terrain.plot.bottom)),\n'
              '          paint,\n'
              '        );\n'
              '      }\n'
              '    }\n'
              '  }\n'
              '\n'
              '  void _drawSurface(Canvas canvas) {\n'
              '    final shader = surfaceShader;\n'
              '    final texture = curveTexture;\n'
              '    if (shader != null && texture != null) {\n'
              '      canvas.save();\n'
              '      canvas.clipPath(terrain.surfacePath);\n'
              '      shader.setFloat(0, terrain.size.width);\n'
              '      shader.setFloat(1, terrain.size.height);\n'
              '      shader.setFloat(2, 1);\n'
              '      shader.setFloat(3, terrain.plot.left);\n'
              '      shader.setFloat(4, terrain.plot.top);\n'
              '      shader.setFloat(5, terrain.plot.width);\n'
              '      shader.setFloat(6, terrain.plot.height);\n'
              '      _FluviWaveMaterial.bind(shader);\n'
              '      shader.setImageSampler(0, texture, filterQuality: FilterQuality.medium);\n'
              '      canvas.drawRect(terrain.plot, Paint()..shader = shader);\n'
              '      canvas.restore();\n'
              '      return;\n'
              '    }\n'
              '    final mesh = terrain.surfaceMesh;\n'
              '    if (mesh != null) {\n'
              '      canvas.drawVertices(mesh, BlendMode.srcOver, Paint()..isAntiAlias = true);\n'
              '    }\n'
              '  }\n'
              '\n'
              '  void _drawContours(Canvas canvas) {\n'
              '    final intensity = switch (style) {\n'
              '      FluviTopographicWaveStyle.terrain => .94,\n'
              '      FluviTopographicWaveStyle.svgReference => 1.08,\n'
              '      FluviTopographicWaveStyle.shaderAtmosphere => .88,\n'
              '    };\n'
              '    for (final layer in terrain.depthLayers.reversed) {\n'
              '      final tint = Color.lerp(\n'
              '        FluviTopographicWavePalette.icyBlue,\n'
              '        FluviTopographicWavePalette.pearl,\n'
              '        1 - layer.depth,\n'
              '      )!;\n'
              '      canvas.drawPath(\n'
              '        layer.path,\n'
              '        Paint()\n'
              '          ..color = tint.withValues(alpha: layer.opacity * intensity)\n'
              '          ..style = PaintingStyle.stroke\n'
              '          ..strokeWidth = .3 + (1 - layer.depth) * .15\n'
              '          ..strokeCap = StrokeCap.round\n'
              '          ..strokeJoin = StrokeJoin.round\n'
              '          ..isAntiAlias = true,\n'
              '      );\n'
              '    }\n'
              '  }\n'
              '\n'
              '  void _drawRidge(Canvas canvas) {\n'
              '    final glowOpacity = style == FluviTopographicWaveStyle.svgReference\n'
              '        ? .13\n'
              '        : .08;\n'
              '    if (debug?.glow ?? true) {\n'
              '      canvas.drawPath(\n'
              '        terrain.ridgePath,\n'
              '        Paint()\n'
              '          ..color = FluviTopographicWavePalette.violet.withValues(\n'
              '            alpha: glowOpacity,\n'
              '          )\n'
              '          ..style = PaintingStyle.stroke\n'
              '          ..strokeWidth = 2\n'
              '          ..strokeCap = StrokeCap.round\n'
              '          ..strokeJoin = StrokeJoin.round\n'
              '          ..maskFilter = const MaskFilter.blur(BlurStyle.normal, 1.2)\n'
              '          ..isAntiAlias = true,\n'
              '      );\n'
              '    }\n'
              '    canvas.drawPath(\n'
              '      terrain.ridgePath,\n'
              '      Paint()\n'
              '        ..color = FluviTopographicWavePalette.pearl.withValues(alpha: .78)\n'
              '        ..style = PaintingStyle.stroke\n'
              '        ..strokeWidth = .9\n'
              '        ..strokeCap = StrokeCap.round\n'
              '        ..strokeJoin = StrokeJoin.round\n'
              '        ..isAntiAlias = true,\n'
              '    );\n'
              '  }\n'
              '\n'
              '  void _drawMarkerAndTooltip(Canvas canvas, Size size) {\n'
              '    final index =\n'
              '        (selectedIndex != null &&\n'
              '            selectedIndex! >= 0 &&\n'
              '            selectedIndex! < terrain.dataOffsets.length)\n'
              '        ? selectedIndex\n'
              '        : terrain.highestIndex;\n'
