              '}\n'
              '\n'
              'enum _ProfileScenario {\n'
              '  // This must remain first: PreparedVectorAssetAtlas is process-scoped, so the\n'
              '  // cold-first fixture has to run before any other Dashboard mounts or raster\n'
              '  // preparation in this integration-test process.\n'
              '  firstFling,\n'
              '  // This starts from a new production dashboard and performs the real mode\n'
              '  // transition and repeated Avatar flings. The global vector atlas is already\n'
              '  // warm from I; its report is intentionally a real Avatar transaction\n'
              '  // proof, not a replacement for user-only cold-device performance evidence.\n'
              '  avatarFirstTarget,\n'
              '  summaryPlane,\n'
              '  yearPopulated,\n'
              '  yearEmpty,\n'
              '  month94,\n'
              '  monthEmpty,\n'
              '  parentWhileRailOpen,\n'
              '  directionWhileRailOpen,\n'
              '  pulseWithParentNavigation,\n'
              '  tenthFling;\n'
              '\n'
              '  String get reportKey => switch (this) {\n'
              '    summaryPlane => \'A_summary_sum_year_month\',\n'
              '    yearPopulated => \'B_year_month_rail_populated\',\n'
              '    yearEmpty => \'C_year_month_rail_empty\',\n'
              '    month94 => \'D_month_day_rail_94\',\n'
              '    monthEmpty => \'E_month_day_rail_empty\',\n'
              '    parentWhileRailOpen => \'F_parent_while_rail_open\',\n'
              '    directionWhileRailOpen => \'G_direction_while_rail_open\',\n'
              '    pulseWithParentNavigation => \'H_pulse_parent_navigation\',\n'
              '    firstFling => \'I_first_fling\',\n'
              '    tenthFling => \'J_tenth_fling\',\n'
              '    avatarFirstTarget => \'K_avatar_first_target\',\n'
              '  };\n'
              '\n'
              '  DateTime get initialDate => switch (this) {\n'
              '    yearEmpty || monthEmpty => DateTime(2024, 7, 14),\n'
              '    _ => DateTime(2026, 7, 14),\n'
              '  };\n'
              '\n'
              '  TimePlane get initialPlane => switch (this) {\n'
              '    summaryPlane => TimePlane.sum,\n'
              '    yearPopulated || yearEmpty => TimePlane.year,\n'
              '    _ => TimePlane.month,\n'
              '  };\n'
              '\n'
              '  bool get initialRailOpen => switch (this) {\n'
              '    summaryPlane || avatarFirstTarget => false,\n'
              '    _ => true,\n'
              '  };\n'
              '\n'
              '  LedgerDirection get initialDirection => switch (this) {\n'
              '    directionWhileRailOpen => LedgerDirection.income,\n'
              '    _ => LedgerDirection.expense,\n'
              '  };\n'
              '}\n'
              '\n'
              'int _expectedParentEntryCount(\n'
              '  _ProfileScenario scenario,\n'
              '  DashboardProfileSeedFixture fixture,\n'
              ') {\n'
              '  final year = scenario.initialPlane == TimePlane.sum\n'
              '      ? null\n'
              '      : scenario.initialDate.year;\n'
              '  final month = scenario.initialPlane == TimePlane.month\n'
              '      ? scenario.initialDate.month\n'
              '      : null;\n'
              '  return switch (scenario.initialDirection) {\n'
              '    LedgerDirection.income => fixture.incomeEntryCount(\n'
              '      year: year,\n'
              '      month: month,\n'
              '    ),\n'
              '    LedgerDirection.expense => fixture.expenseEntryCount(\n'
              '      year: year,\n'
              '      month: month,\n'
              '    ),\n'
              '  };\n'
              '}\n'
              '\n'
              'Future<Map<String, dynamic>> _runScenario(\n'
              '  IntegrationTestWidgetsFlutterBinding binding,\n'
              '  WidgetTester tester,\n'
              '  _ProfileScenario scenario,\n'
              '  DashboardProfileSeedFixture fixture,\n'
              ') async {\n'
              '  final repository = MethodChannelDashboardDataRuntimeRepository();\n'
              '  final firstValidPaintTimer = Stopwatch()..start();\n'
              '  await tester.pumpWidget(\n'
              '    FluviApp(\n'
              '      dashboardRepository: repository,\n'
              '      initialDate: scenario.initialDate,\n'
              '      initialPlane: scenario.initialPlane,\n'
              '      initialRailOpen: scenario.initialRailOpen,\n'
              '      initialDirection: scenario.initialDirection,\n'
              '    ),\n'
              '  );\n'
              '  await _pumpUntilDashboardReady(tester);\n'
              '  firstValidPaintTimer.stop();\n'
              '  final controller = tester\n'
              '      .widget<CoreDashboard>(find.byType(CoreDashboard))\n'
              '      .controller;\n'
              '  final expectedParentEntryCount = _expectedParentEntryCount(scenario, fixture);\n'
              '  await _prepareScenario(\n'
              '    tester,\n'
              '    controller,\n'
              '    scenario,\n'
              '    expectedParentEntryCount: expectedParentEntryCount,\n'
              '  );\n'
              '  debugPrint(\n'
              '    \'[PROFILE][SCENARIO_PREPARED] ${scenario.reportKey} \'\n'
              '    \'plane=${controller.navigation.state.plane.name}\',\n'
              '  );\n'
              '  if (scenario == _ProfileScenario.tenthFling) {\n'
              '    await _settle(tester);\n'
              '  }\n'
              '  debugPrint(\'[PROFILE][SCENARIO_STABLE] ${scenario.reportKey}\');\n'
              '\n'
              '  final carousel = controller.motion.carouselController;\n'
              '  final scrollController = carousel.scrollController;\n'
              '  final position = scrollController.position;\n'
              '  final physics = controller.motion.dashboardPhysics;\n'
              '  final identitiesBefore = <String, int>{\n'
              '    \'motion_kernel\': identityHashCode(controller.motion),\n'
              '    \'carousel_controller\': identityHashCode(carousel),\n'
              '    \'scroll_controller\': identityHashCode(scrollController),\n'
              '    \'scroll_position\': identityHashCode(position),\n'
              '    \'physics\': identityHashCode(physics),\n'
              '  };\n'
              '  final semanticSequence = <int>[];\n'
              '  final visibleSemanticSequence = <int>[];\n'
              '  var traversalCatalog = controller.motion.catalog;\n'
              '  final rawStartIndex = carousel.selectedLogicalIndex;\n'
              '  var previousRawIndex = rawStartIndex;\n'
              '  void collectMotionTraversal() {\n'
              '    final currentCatalog = controller.motion.catalog;\n'
              '    final currentRawIndex = carousel.selectedLogicalIndex;\n'
              '    if (!identical(currentCatalog, traversalCatalog)) {\n'
              '      traversalCatalog = currentCatalog;\n'
              '      previousRawIndex = currentRawIndex;\n'
              '      return;\n'
              '    }\n'
              '    DashboardProfileReport.appendSemanticTraversal(\n'
              '      semanticSequence,\n'
              '      previousRawIndex: previousRawIndex,\n'
              '      currentRawIndex: currentRawIndex,\n'
              '      normalize: (rawIndex) =>\n'
              '          currentCatalog.entryAtLogicalIndex(rawIndex).logicalIndex,\n'
              '    );\n'
              '    previousRawIndex = currentRawIndex;\n'
              '  }\n'
              '\n'
              '  void collectVisible() {\n'
              '    final index = controller.visibleFrames.value?.semanticChildIndex;\n'
              '    if (index != null &&\n'
              '        (visibleSemanticSequence.isEmpty ||\n'
              '            visibleSemanticSequence.last != index)) {\n'
              '      visibleSemanticSequence.add(index);\n'
              '    }\n'
              '  }\n'
              '\n'
              '  final isAvatarFirstTarget = scenario == _ProfileScenario.avatarFirstTarget;\n'
              '  final avatarPaints = <DashboardAvatarTargetPainted>[];\n'
              '  final avatarFlights = <Map<String, Object?>>[];\n'
              '  final avatarEvents = <FluviDiagnosticEvent>[];\n'
              '  final avatarFixture = isAvatarFirstTarget\n'
              '      ? _verifyAvatarNonemptyFixture(tester, controller)\n'
              '      : <String, Object?>{};\n'
              '  var timeInteractionCount = 0;\n'
              '  var avatarMotionLaneObserved = false;\n'
              '  void collectAvatarPaint() {\n'
              '    final painted = controller.budgetAvatarTargetPainted.value;\n'
              '    if (painted == null ||\n'
              '        avatarPaints.any(\n'
              '          (candidate) =>\n'
              '              candidate.targetHandle == painted.targetHandle &&\n'
              '              candidate.focusGeneration == painted.focusGeneration &&\n'
              '              candidate.presentationEpoch == painted.presentationEpoch &&\n'
              '              candidate.frameGeneration == painted.frameGeneration,\n'
              '        )) {\n'
              '      return;\n'
              '    }\n'
              '    avatarPaints.add(painted);\n'
              '  }\n'
              '\n'
              '  void collectAvatarMotionLane() {\n'
              '    if (controller.isMotionLaneActive(DashboardMotionLane.rail) ||\n'
              '        controller.isMotionLaneActive(DashboardMotionLane.summaryShell)) {\n'
              '      timeInteractionCount += 1;\n'
              '    }\n'
              '    avatarMotionLaneObserved =\n'
              '        avatarMotionLaneObserved ||\n'
              '        controller.isMotionLaneActive(DashboardMotionLane.budgetAvatar);\n'
              '  }\n'
              '\n'
              '  controller.motion.addListener(collectMotionTraversal);\n'
              '  controller.visibleFrames.addListener(collectVisible);\n'
              '  if (isAvatarFirstTarget) {\n'
              '    controller.budgetAvatarTargetPainted.addListener(collectAvatarPaint);\n'
              '    controller.foregroundInputMotion.addListener(collectAvatarMotionLane);\n'
              '  }\n'
              '  controller.performanceCounters.reset();\n'
              '  final railFlightRecorder = controller.railFlightRecorder;\n'
              '  expect(\n'
              '    railFlightRecorder,\n'
              '    isNotNull,\n'
              '    reason: \'Profile builds must enable FLUVI_RAIL_FLIGHT_RECORDER.\',\n'
              '  );\n'
              '  railFlightRecorder!.clear();\n'
              '  final vectorAtlas = PreparedVectorAssetAtlas.instance;\n'
              '  final vectorPictureDecodesBefore = vectorAtlas.pictureDecodeCount;\n'
              '  final repositoryBefore = repository.performanceReport();\n'
              '  final visiblePublishesBefore = controller.visibleFrames.visiblePublishCount;\n'
              '  final coalescedPublishesBefore = controller.frameCoalescer.publishCount;\n'
              '  final staleCallbacksBefore =\n'
              '      controller.dataRuntime.discardedIndexCount +\n'
              '      controller.paging.stalePageRejectCount;\n'
              '  final rssBefore = ProcessInfo.currentRss;\n'
              '  final maxRssBefore = ProcessInfo.maxRss;\n'
              '  final startIndex = traversalCatalog\n'
              '      .entryAtLogicalIndex(rawStartIndex)\n'
              '      .logicalIndex;\n'
              '  // `_captureProfilePerformance` deliberately lets the dashboard settle\n'
              '  // before it starts its trace.  Capture this boundary inside the traced\n'
              '  // action, immediately before the measured gesture, so a completed\n'
              '  // pre-capture warmup is never attributed to motion.\n'
              '  late int completedScenePreparationEpochAtMotionStart;\n'
              '  final frameKey = \'${scenario.reportKey}_frames\';\n'
              '  final timelineKey = \'${scenario.reportKey}_timeline\';\n'
              '  final motionDuration = Stopwatch();\n'
              '\n'
              '  await _captureProfilePerformance(\n'
              '    binding,\n'
              '    () => _timelineStep(scenario.reportKey, () async {\n'
              '      completedScenePreparationEpochAtMotionStart = _scenePreparationEpoch(\n'
              '        Map<String, Object?>.from(\n'
              '          controller.exportPhysicalRailReport()[\'sceneWindow\']! as Map,\n'
              '        ),\n'
              '      );\n'
              '      motionDuration.start();\n'
              '      try {\n'
              '        await _runMeasuredScenario(\n'
              '          tester,\n'
              '          controller,\n'
              '          scenario,\n'
              '          avatarPaints: avatarPaints,\n'
              '          avatarMotionLaneObserved: () => avatarMotionLaneObserved,\n'
              '          avatarFlights: avatarFlights,\n'
              '          avatarEvents: avatarEvents,\n'
              '          avatarFixture: avatarFixture,\n'
              '          timeInteractionCount: () => timeInteractionCount,\n'
              '          onAvatarEvidence: (evidence) {\n'
              '            binding\n'
              '                .reportData![\'dashboard_avatar_target_completion_evidence\'] = {\n'
              '              ...avatarFixture,\n'
              '              \'completed_flights\': List<Map<String, Object?>>.of(avatarFlights),\n'
              '              \'current_flight\': evidence,\n'
              '            };\n'
              '          },\n'
              '        );\n'
              '      } finally {\n'
              '        motionDuration.stop();\n'
              '      }\n'
              '    }),\n'
              '    frameKey: frameKey,\n'
              '    timelineKey: timelineKey,\n'
              '    preCaptureDelay: scenario == _ProfileScenario.firstFling\n'
              '        ? Duration.zero\n'
              '        : const Duration(seconds: 2),\n'
              '  );\n'
              '  controller.motion.removeListener(collectMotionTraversal);\n'
              '  controller.visibleFrames.removeListener(collectVisible);\n'
              '  if (isAvatarFirstTarget) {\n'
              '    controller.budgetAvatarTargetPainted.removeListener(collectAvatarPaint);\n'
              '    controller.foregroundInputMotion.removeListener(collectAvatarMotionLane);\n'
              '  }\n'
              '\n'
              '  if (isAvatarFirstTarget) {\n'
              '    // Performance capture waits for the renderer after the last gesture.\n'
              '    // Re-read final owners now as well: a delayed older canonical install\n'
              '    // must not overwrite an already checked final target during that wait.\n'
              '    final lastFlight = avatarFlights.last;\n'
              '    final finalEvidence = _avatarFinalTargetEvidence(\n'
              '      tester,\n'
              '      controller,\n'
              '      paints: avatarPaints.sublist(\n'
              '        lastFlight[\'flight_start_paint_count\']! as int,\n'
              '      ),\n'
              '      events: _diagnosticEventsAfter(\n'
              '        lastFlight[\'flight_start_sequence\']! as int,\n'
              '      ),\n'
              '      fixture: avatarFixture,\n'
              '      timeInteractionCount: timeInteractionCount,\n'
              '    );\n'
              '    binding.reportData![\'dashboard_avatar_final_target_evidence\'] =\n'
              '        finalEvidence;\n'
              '    DashboardProfileReport.validateAvatarFinalTargetEvidence(finalEvidence);\n'
              '    avatarFlights[avatarFlights.length - 1] = {...lastFlight, ...finalEvidence};\n'
              '  }\n'
              '  final rawFrameReport = binding.reportData?[frameKey];\n'
              '  expect(rawFrameReport, isA<Map>());\n'
              '  final report = Map<String, dynamic>.from(rawFrameReport! as Map);\n'
              '  DashboardProfileReport.addRequiredPercentiles(report);\n'
              '  final railFlightEvents = railFlightRecorder.snapshot();\n'
              '  final visible = controller.visibleFrames.value!;\n'
              '  final avatarFirstTargetEvidence = isAvatarFirstTarget\n'
              '      ? _avatarFirstTargetEvidence(\n'
              '          controller: controller,\n'
              '          paints: avatarPaints,\n'
              '          diagnosticEvents: avatarEvents,\n'
              '          flights: avatarFlights,\n'
              '          fixture: avatarFixture,\n'
              '          motionLaneObserved: avatarMotionLaneObserved,\n'
              '        )\n'
              '      : null;\n'
              '  final identitiesAfter = <String, int>{\n'
              '    \'motion_kernel\': identityHashCode(controller.motion),\n'
              '    \'carousel_controller\': identityHashCode(\n'
              '      controller.motion.carouselController,\n'
              '    ),\n'
              '    \'scroll_controller\': identityHashCode(\n'
              '      controller.motion.carouselController.scrollController,\n'
              '    ),\n'
              '    \'scroll_position\': identityHashCode(\n'
              '      controller.motion.carouselController.scrollController.position,\n'
              '    ),\n'
              '    \'physics\': identityHashCode(controller.motion.dashboardPhysics),\n'
              '  };\n'
              '  final repositoryAfter = repository.performanceReport();\n'
              '  final platformChannelMicros = _durationListDelta(\n'
              '    repositoryBefore,\n'
              '    repositoryAfter,\n'
              '    \'platform_duration_micros\',\n'
              '  );\n'
              '  final dartParsingMicros = _durationListDelta(\n'
              '    repositoryBefore,\n'
              '    repositoryAfter,\n'
              '    \'index_decode_duration_micros\',\n'
              '  );\n'
              '  final indexMetrics = controller.preparedIndex!.buildMetrics;\n'
              '  final physicalRailReport = controller.exportPhysicalRailReport();\n'
              '  final sceneWindowReport = Map<String, Object?>.from(\n'
              '    physicalRailReport[\'sceneWindow\']! as Map,\n'
              '  );\n'
              '  final completedScenePreparationEpochAfterMotion = _scenePreparationEpoch(\n'
              '    sceneWindowReport,\n'
              '  );\n'
              '  final completedScenePreparationsDuringMotion =\n'
              '      completedScenePreparationEpochAfterMotion -\n'
              '      completedScenePreparationEpochAtMotionStart;\n'
              '  final motionScopedScenePreparationSliceMicros =\n'
              '      DashboardProfileReport.motionScopedScenePreparationSliceMicros(\n'
              '        completedPreparationEpochAtMotionStart:\n'
              '            completedScenePreparationEpochAtMotionStart,\n'
              '        completedPreparationEpochAtMotionEnd:\n'
              '            completedScenePreparationEpochAfterMotion,\n'
              '        lastCompletedSliceMicros: _scenePreparationSliceMicros(\n'
              '          sceneWindowReport,\n'
              '        ),\n'
              '      );\n'
              '  final memoryBudget = Map<String, Object?>.from(\n'
              '    physicalRailReport[\'memoryBudget\']! as Map,\n'
              '  );\n'
              '  report.addAll(<String, dynamic>{\n'
              '    \'scenario\': scenario.reportKey,\n'
              '    \'expected_parent_entry_count\': expectedParentEntryCount,\n'
              '    \'rss_before_bytes\': rssBefore,\n'
              '    \'rss_after_bytes\': ProcessInfo.currentRss,\n'
              '    \'rss_delta_bytes\': ProcessInfo.currentRss - rssBefore,\n'
              '    \'allocation_burst_rss_bytes\': ProcessInfo.currentRss - rssBefore,\n'
              '    \'max_rss_before_bytes\': maxRssBefore,\n'
              '    \'max_rss_after_bytes\': ProcessInfo.maxRss,\n'
              '    \'peak_rss_bytes\': math.max(maxRssBefore, ProcessInfo.maxRss),\n'
              '    \'first_valid_paint_micros\': firstValidPaintTimer.elapsedMicroseconds,\n'
              '    \'index_publish_duration_micros\':\n'
              '        controller.dataRuntime.lastIndexPublishDurationMicros,\n'
              '    \'prepared_index_bytes\': indexMetrics.estimatedIndexBytes,\n'
              '    \'logbox_raster_bytes\': vectorAtlas.logBoxRasterByteEstimate,\n'
              '    \'logbox_raster_prepare_duration_micros\':\n'
              '        vectorAtlas.logBoxRasterPrepareDurationMicros,\n'
              '    \'logbox_text_layout_estimated_bytes\':\n'
              '        memoryBudget[\'logBoxTextLayoutEstimatedBytes\'],\n'
              '    \'logbox_text_layout_prepared_rows\':\n'
              '        memoryBudget[\'logBoxTextLayoutPreparedRows\'],\n'
              '    \'logbox_text_layout_prepared_day_headers\':\n'
              '        memoryBudget[\'logBoxTextLayoutPreparedDayHeaders\'],\n'
              '    \'vector_picture_decode_count\': vectorAtlas.pictureDecodeCount,\n'
              '    \'vector_picture_prepare_duration_micros\': vectorAtlas.prepareDurationMicros,\n'
              '    \'vector_picture_decodes_during_motion\':\n'
              '        vectorAtlas.pictureDecodeCount - vectorPictureDecodesBefore,\n'
              '    \'motion_duration_micros\': motionDuration.elapsedMicroseconds,\n'
              '    \'scene_preparation_largest_contiguous_ui_slice_micros\':\n'
              '        motionScopedScenePreparationSliceMicros,\n'
              '    \'scene_preparation_completed_during_motion\':\n'
              '        completedScenePreparationsDuringMotion,\n'
              '    \'platform_channel_duration_micros\': platformChannelMicros,\n'
              '    \'sql_duration_micros\': 0,\n'
              '    \'dart_parsing_duration_micros\': dartParsingMicros,\n'
              '    \'prepared_projection_duration_micros\': dartParsingMicros,\n'
              '    \'sql_call_count\': 0,\n'
              '    \'platform_call_count\': _scalarDelta(\n'
              '      repositoryBefore,\n'
              '      repositoryAfter,\n'
              '      \'platform_calls\',\n'
              '    ),\n'
              '    \'index_build_call_count\': _scalarDelta(\n'
              '      repositoryBefore,\n'
              '      repositoryAfter,\n'
              '      \'index_build_calls\',\n'
              '    ),\n'
              '    \'page_read_count\': _scalarDelta(\n'
              '      repositoryBefore,\n'
              '      repositoryAfter,\n'
              '      \'page_read_calls\',\n'
              '    ),\n'
              '    \'startup_index_metrics\': <String, Object?>{\n'
              '      \'sql_call_count\': indexMetrics.sqlCallCount,\n'
              '      \'sql_duration_micros\': indexMetrics.nativeSqlDurationMicros,\n'
              '      \'native_query_micros\': indexMetrics.nativeQueryDurationMicros,\n'
              '      \'native_aggregation_micros\': indexMetrics.nativeAggregationDurationMicros,\n'
              '      \'native_mapping_micros\': indexMetrics.nativeMappingDurationMicros,\n'
              '      \'serialization_micros\': indexMetrics.serializationDurationMicros,\n'
              '      \'bridge_transfer_micros\': indexMetrics.bridgeTransferDurationMicros,\n'
              '      \'dart_decode_micros\': indexMetrics.dartDecodeDurationMicros,\n'
              '      \'dart_projection_micros\': indexMetrics.dartProjectionDurationMicros,\n'
              '      \'index_publish_micros\':\n'
              '          controller.dataRuntime.lastIndexPublishDurationMicros,\n'
              '      \'first_valid_paint_micros\': firstValidPaintTimer.elapsedMicroseconds,\n'
              '      \'payload_bytes\': indexMetrics.payloadBytes,\n'
              '      \'estimated_index_bytes\': indexMetrics.estimatedIndexBytes,\n'
              '    },\n'
              '    \'native_payload_bytes\': _durationListDelta(\n'
              '      repositoryBefore,\n'
              '      repositoryAfter,\n'
              '      \'payload_bytes\',\n'
              '    ),\n'
              '    \'benchmark_environment\': <String, Object?>{\n'
              '      \'source\': \'native-room-sqlite-binary-worker-isolate\',\n'
              '      \'operating_system\': Platform.operatingSystem,\n'
              '      \'operating_system_version\': Platform.operatingSystemVersion,\n'
              '      \'number_of_processors\': Platform.numberOfProcessors,\n'
              '      \'dart_version\': Platform.version,\n'
              '    },\n'
              '    \'performance_counters\': _counterReport(controller),\n'
              '    \'rail_flight\': _railFlightReport(\n'
              '      railFlightEvents,\n'
              '      overwrittenEventCount: railFlightRecorder.overwrittenEventCount,\n'
              '    ),\n'
              '    \'physical_rail_report\': physicalRailReport,\n'
              '    \'repository_before\': repositoryBefore,\n'
              '    \'repository_after\': repositoryAfter,\n'
              '    \'gc\': _gcReport(binding.reportData?[timelineKey]),\n'
              '    \'semantic_sequence\': semanticSequence,\n'
              '    \'visible_semantic_sequence\': visibleSemanticSequence,\n'
              '    \'rail_start_index\': startIndex,\n'
              '    \'rail_target_index\': controller.motion.state.semanticIndex,\n'
              '    \'rail_settle_index\': controller.motion.state.semanticIndex,\n'
              '    \'visible_publish_count\':\n'
              '        controller.visibleFrames.visiblePublishCount - visiblePublishesBefore,\n'
              '    \'coalesced_publish_count\':\n'
              '        controller.frameCoalescer.publishCount - coalescedPublishesBefore,\n'
              '    \'max_publishes_per_display_frame\':\n'
              '        controller.frameCoalescer.maximumPublishesInOneDisplayFrame,\n'
              '    \'stale_callback_count\':\n'
              '        controller.dataRuntime.discardedIndexCount +\n'
              '        controller.paging.stalePageRejectCount -\n'
              '        staleCallbacksBefore,\n'
              '    \'identities_before\': identitiesBefore,\n'
              '    \'identities_after\': identitiesAfter,\n'
              '    \'controller_recreation_count\':\n'
              '        identitiesBefore[\'carousel_controller\'] ==\n'
              '            identitiesAfter[\'carousel_controller\']\n'
              '        ? 0\n'
              '        : 1,\n'
              '    \'physics_recreation_count\':\n'
              '        identitiesBefore[\'physics\'] == identitiesAfter[\'physics\'] ? 0 : 1,\n'
              '    \'scroll_position_recreation_count\':\n'
              '        identitiesBefore[\'scroll_position\'] ==\n'
              '            identitiesAfter[\'scroll_position\']\n'
              '        ? 0\n'
              '        : 1,\n'
              '    \'visible_query_key\': visible.queryKey.value,\n'
              '    \'visible_parent_query_key\': visible.parentQueryKey.value,\n'
              '    \'visible_revision\': visible.coreRevision,\n'
              '    \'verbose_flow_enabled\': false,\n'
              '    \'avatar_first_target\': ?avatarFirstTargetEvidence,\n'
              '  });\n'
              '  binding.reportData!\n'
              '    ..remove(frameKey)\n'
              '    ..remove(timelineKey);\n'
              '  DashboardProfileReport.validateRequiredScenarioMetrics(report);\n'
              '  binding.reportData![scenario.reportKey] = report;\n'
              '\n'
              '  _expectFrameInvariant(controller);\n'
              '  expect(\n'
              '    controller.frameCoalescer.maximumPublishesInOneDisplayFrame,\n'
              '    lessThanOrEqualTo(1),\n'
              '  );\n'
              '  expect(identitiesAfter, identitiesBefore);\n'
              '  for (final metric in <DashboardPerformanceMetric>[\n'
              '    DashboardPerformanceMetric.sqlCallsDuringMotion,\n'
              '    DashboardPerformanceMetric.platformCallsDuringMotion,\n'
              '    DashboardPerformanceMetric.repositoryReadsDuringMotion,\n'
              '    DashboardPerformanceMetric.liveLeaseStartsDuringMotion,\n'
              '    DashboardPerformanceMetric.logBoxProjectionsDuringMotion,\n'
              '    DashboardPerformanceMetric.formattingDuringMotion,\n'
              '    DashboardPerformanceMetric.railPresentationDataDependencyViolation,\n'
              '  ]) {\n'
              '    expect(controller.performanceCounters.value(metric), 0);\n'
              '  }\n'
              '\n'
              '  await tester.pumpWidget(const SizedBox.shrink());\n'
              '  await _settle(tester);\n'
              '  return report;\n'
              '}\n'
              '\n'
              'int _scenePreparationEpoch(Map<String, Object?> sceneWindowReport) {\n'
              '  final value = sceneWindowReport[\'completedPreparationEpoch\'];\n'
              '  if (value is! int || value < 0) {\n'
              '    throw StateError(\n'
              '      \'Profile scene window has invalid completedPreparationEpoch=$value.\',\n'
              '    );\n'
              '  }\n'
              '  return value;\n'
              '}\n'
              '\n'
              'int _scenePreparationSliceMicros(Map<String, Object?> sceneWindowReport) {\n'
              '  final value = sceneWindowReport[\'lastPrepareLargestContiguousUiSliceMicros\'];\n'
              '  if (value is! int || value < 0) {\n'
              '    throw StateError(\n'
              '      \'Profile scene window has invalid \'\n'
              '      \'lastPrepareLargestContiguousUiSliceMicros=$value.\',\n'
              '    );\n'
              '  }\n'
              '  return value;\n'
              '}\n'
              '\n'
              'Map<String, Object?> _railFlightReport(\n'
              '  List<DashboardRailFlightEvent> events, {\n'
              '  required int overwrittenEventCount,\n'
              '}) {\n'
              '  DashboardRailFlightEvent? last(DashboardRailFlightEventType type) {\n'
              '    for (var index = events.length - 1; index >= 0; index -= 1) {\n'
              '      if (events[index].type == type) return events[index];\n'
              '    }\n'
              '    return null;\n'
              '  }\n'
              '\n'
              '  int percentile(List<int> values, double fraction) => values.isEmpty\n'
              '      ? 0\n'
              '      : DashboardProfileReport.percentileMicros(values, fraction);\n'
              '\n'
              '  final release = last(DashboardRailFlightEventType.gestureReleased);\n'
              '  final ballistic = last(DashboardRailFlightEventType.ballisticStarted);\n'
              '  final settle = last(DashboardRailFlightEventType.railSettled);\n'
              '  final timing = last(DashboardRailFlightEventType.frameTiming);\n'
              '  final sample = last(DashboardRailFlightEventType.gestureSampleSummary);\n'
              '  final applyMicros = events\n'
              '      .where(\n'
              '        (event) =>\n'
              '            event.type ==\n'
              '            DashboardRailFlightEventType.presentationApplyCompleted,\n'
              '      )\n'
              '      .map((event) => event.applyMicros)\n'
              '      .toList(growable: false);\n'
              '  return <String, Object?>{\n'
              '    \'event_count\': events.length,\n'
              '    \'overwritten_event_count\': overwrittenEventCount,\n'
              '    \'gesture_id\': settle?.gestureId ?? release?.gestureId ?? 0,\n'
              '    \'drag_end_velocity\': release?.dragEndVelocity,\n'
              '    \'primary_velocity\': release?.primaryVelocity,\n'
              '    \'ballistic_input_velocity\': ballistic?.ballisticInputVelocity,\n'
              '    \'simulation_target_pixels\': ballistic?.targetPixels,\n'
              '    \'item_extent\':\n'
              '        ballistic?.geometry?.itemExtent ?? settle?.geometry?.itemExtent,\n'
              '    \'start_pixels\': settle?.startPixels,\n'
              '    \'final_pixels\': settle?.finalPixels,\n'
              '    \'total_pixel_distance\': settle == null\n'
              '        ? null\n'
              '        : settle.finalPixels - settle.startPixels,\n'
              '    \'start_logical_index\': settle?.startLogicalIndex,\n'
              '    \'final_logical_index\': settle?.finalLogicalIndex,\n'
              '    \'logical_delta\': settle == null\n'
              '        ? null\n'
              '        : settle.finalLogicalIndex - settle.startLogicalIndex,\n'
              '    \'activity_interrupt_count\': settle?.activityInterruptCount ?? 0,\n'
              '    \'metric_change_count\': settle?.metricChangeCount ?? 0,\n'
              '    \'populated_child_cross_count\': settle?.populatedChildCrossCount ?? 0,\n'
              '    \'empty_child_cross_count\': settle?.emptyChildCrossCount ?? 0,\n'
              '    \'presentation_apply_total_micros\':\n'
              '        settle?.presentationApplyTotalMicros ?? 0,\n'
              '    \'presentation_apply_max_micros\': settle?.presentationApplyMaxMicros ?? 0,\n'
              '    \'presentation_apply_p50_micros\': percentile(applyMicros, .50),\n'
              '    \'presentation_apply_p95_micros\': percentile(applyMicros, .95),\n'
              '    \'presentation_apply_p99_micros\': percentile(applyMicros, .99),\n'
              '    \'root_rebuild_count\': settle?.rootRebuildCount ?? 0,\n'
              '    \'rail_rebuild_count\': settle?.railRebuildCount ?? 0,\n'
              '    \'log_viewport_rebuild_count\': settle?.logViewportRebuildCount ?? 0,\n'
              '    \'data_io_count\': settle?.dataIoCount ?? 0,\n'
              '    \'platform_call_count\': settle?.platformCallCount ?? 0,\n'
              '    \'sql_count\': settle?.sqlCount ?? 0,\n'
              '    \'gesture_sample_count\': sample?.sampleCount ?? 0,\n'
              '    \'pointer_gap_p50_micros\': sample?.pointerEventGapP50Micros ?? 0,\n'
              '    \'pointer_gap_p95_micros\': sample?.pointerEventGapP95Micros ?? 0,\n'
              '    \'longest_pointer_gap_micros\': sample?.longestPointerEventGapMicros ?? 0,\n'
              '    \'ui_frame_p50_micros\': timing?.uiFrameP50Micros ?? 0,\n'
              '    \'ui_frame_p95_micros\': timing?.uiFrameP95Micros ?? 0,\n'
              '    \'ui_frame_p99_micros\': timing?.uiFrameP99Micros ?? 0,\n'
              '    \'raster_frame_p50_micros\': timing?.rasterFrameP50Micros ?? 0,\n'
              '    \'raster_frame_p95_micros\': timing?.rasterFrameP95Micros ?? 0,\n'
              '    \'raster_frame_p99_micros\': timing?.rasterFrameP99Micros ?? 0,\n'
              '    \'build_duration_micros\': timing?.buildDurationMicros ?? 0,\n'
              '    \'layout_duration_micros\': timing?.layoutDurationMicros ?? 0,\n'
              '    \'paint_duration_micros\': timing?.paintDurationMicros ?? 0,\n'
              '    \'raster_duration_micros\': timing?.rasterDurationMicros ?? 0,\n'
              '    \'controller_identity\': settle?.identities?.controllerIdentity,\n'
              '    \'position_identity\': settle?.identities?.positionIdentity,\n'
              '    \'physics_identity\': settle?.identities?.physicsIdentity,\n'
              '    \'viewport_identity\': settle?.identities?.viewportIdentity,\n'
              '    \'events\': events\n'
              '        .map((event) => event.toReportMap())\n'
              '        .toList(growable: false),\n'
              '  };\n'
              '}\n'
              '\n'
              'int _lastDiagnosticSequence() {\n'
              '  final entries = FluviDiagnosticLogger.entries;\n'
              '  return entries.isEmpty ? 0 : entries.last.sequence ?? 0;\n'
              '}\n'
              '\n'
              'List<FluviDiagnosticEvent> _diagnosticEventsAfter(int sequence) =>\n'
              '    FluviDiagnosticLogger.entries\n'
              '        .where((event) => (event.sequence ?? 0) > sequence)\n'
              '        .toList(growable: false);\n'
              '\n'
              '/// Produces bounded, JSON-safe evidence for repeated real Avatar flings in the\n'
              '/// profile matrix. It only observes existing Core paint acknowledgement and\n'
              '/// bounded diagnostics; neither this harness nor the report owns selection,\n'
              '/// resource readiness, or presentation state.\n'
              'Map<String, Object?> _avatarFirstTargetEvidence({\n'
              '  required DashboardCoreController controller,\n'
              '  required List<DashboardAvatarTargetPainted> paints,\n'
              '  required List<FluviDiagnosticEvent> diagnosticEvents,\n'
              '  required List<Map<String, Object?>> flights,\n'
              '  required Map<String, Object?> fixture,\n'
              '  required bool motionLaneObserved,\n'
              '}) {\n'
              '  final stageCounts = <String, int>{};\n'
              '  for (final event in diagnosticEvents) {\n'
              '    stageCounts.update(\n'
              '      event.stage,\n'
              '      (count) => count + event.repeatCount,\n'
              '      ifAbsent: () => event.repeatCount,\n'
              '    );\n'
              '  }\n'
              '  Iterable<FluviDiagnosticEvent> eventsFor(String stage) =>\n'
              '      diagnosticEvents.where((event) => event.stage == stage);\n'
              '  List<int> targetHandlesFor(String stage) => eventsFor(stage)\n'
              '      .map((event) => _scopeInt(event.scope, \'targetHandle\'))\n'
              '      .whereType<int>()\n'
              '      .toSet()\n'
              '      .toList(growable: false);\n'
              '\n'
              '  final exactPaintTargetHandles = paints\n'
              '      .map((paint) => paint.targetHandle)\n'
              '      .toSet()\n'
              '      .toList(growable: false);\n'
              '  final progressTargetHandles = targetHandlesFor(\'BUDGET_PROGRESS_PAINTED\');\n'
              '  final firstTargetPipelines = eventsFor(\n'
              '    \'AVATAR_FIRST_TARGET_PIPELINE_SUMMARY\',\n'
              '  ).toList(growable: false);\n'
              '  final motionSummaries = eventsFor(\n'
              '    \'BUDGET_AVATAR_MOTION_SUMMARY\',\n'
              '  ).toList(growable: false);\n'
              '  final terminalOutcomes = firstTargetPipelines\n'
              '      .map((event) => _scopeField(event.scope, \'terminalOutcome\'))\n'
              '      .whereType<String>()\n'
              '      .toSet()\n'
              '      .toList(growable: false);\n'
              '  final latestPaint = paints.isEmpty ? null : paints.last;\n'
              '  final visible = controller.visibleFrames.value;\n'
              '  final latestExactPaintMatchesVisible =\n'
              '      latestPaint != null &&\n'
              '      visible != null &&\n'
              '      latestPaint.queryKey == visible.queryKey.value &&\n'
              '      latestPaint.coreRevision == visible.coreRevision;\n'
              '\n'
              '  return <String, Object?>{\n'
              '    ...flights.last,\n'
              '    ...fixture,\n'
              '    \'real_fling_count\': flights.length,\n'
              '    \'preview_requested_count\': flights.fold<int>(\n'
              '      0,\n'
              '      (n, flight) => n + (flight[\'preview_requested_count\']! as int),\n'
              '    ),\n'
              '    \'preview_terminal_count\': flights.fold<int>(\n'
              '      0,\n'
              '      (n, flight) => n + (flight[\'preview_terminal_count\']! as int),\n'
              '    ),\n'
              '    \'preview_terminal_classifications\': _avatarTerminalClassifications(\n'
              '      diagnosticEvents,\n'
              '    ),\n'
              '    \'flights\': flights,\n'
              '    for (final key in const [\n'
              '      \'nonempty_preview_requested_count\',\n'
              '      \'nonempty_preview_accepted_count\',\n'
              '      \'nonempty_preview_painted_count\',\n'
              '      \'exact_local_hotset_unavailable_count\',\n'
              '      \'generic_coordinator_rejected_count\',\n'
              '    ])\n'
              '      key: flights.fold<int>(\n'
              '        0,\n'
              '        (count, flight) => count + (flight[key]! as int),\n'
              '      ),\n'
              '    \'motion_lane_observed\': motionLaneObserved,\n'
              '    \'pointer_accepted_count\': stageCounts[\'AV|POINTER_ACCEPTED\'] ?? 0,\n'
              '    \'preview_accepted_count\': stageCounts[\'AV|PREVIEW_ACCEPTED\'] ?? 0,\n'
              '    \'exact_phase_a_paint_count\': paints.length,\n'
              '    \'exact_phase_a_target_handles\': exactPaintTargetHandles,\n'
              '    \'exact_phase_a_all_readable\':\n'
              '        paints.isNotEmpty &&\n'
              '        paints.every(\n'
              '          (paint) =>\n'
              '              paint.exactEmpty ||\n'
              '              DashboardProfileReport.hasExactNonemptyAvatarPaint(\n'
              '                exactEmpty: paint.exactEmpty,\n'
              '                readablePhaseARowsPainted: paint.readablePhaseARowsPainted,\n'
              '                richPhaseBRowsPainted: paint.richPhaseBRowsPainted,\n'
              '              ),\n'
              '        ),\n'
              '    \'latest_exact_paint_matches_visible\': latestExactPaintMatchesVisible,\n'
              '    \'latest_exact_paint\': latestPaint == null\n'
              '        ? null\n'
              '        : <String, Object?>{\n'
              '            \'target_handle\': latestPaint.targetHandle,\n'
              '            \'focus_generation\': latestPaint.focusGeneration,\n'
              '            \'query_key\': latestPaint.queryKey,\n'
              '            \'core_revision\': latestPaint.coreRevision,\n'
              '            \'presentation_epoch\': latestPaint.presentationEpoch,\n'
              '            \'frame_generation\': latestPaint.frameGeneration,\n'
              '            \'exact_empty\': latestPaint.exactEmpty,\n'
              '            \'readable_phase_a_rows_painted\':\n'
              '                latestPaint.readablePhaseARowsPainted,\n'
              '            \'rich_phase_b_rows_painted\': latestPaint.richPhaseBRowsPainted,\n'
              '          },\n'
              '    \'budget_progress_painted_count\':\n'
              '        stageCounts[\'BUDGET_PROGRESS_PAINTED\'] ?? 0,\n'
              '    \'budget_progress_target_handles\': progressTargetHandles,\n'
              '    \'budget_progress_matches_exact_paint\':\n'
              '        progressTargetHandles.isNotEmpty &&\n'
              '        progressTargetHandles.every(exactPaintTargetHandles.contains),\n'
              '    \'first_pipeline_summary_count\': firstTargetPipelines.length,\n'
              '    \'first_pipeline_terminal_outcomes\': terminalOutcomes,\n'
              '    \'first_pipeline_scopes\': firstTargetPipelines\n'
              '        .map((event) => event.scope ?? \'\')\n'
              '        .toList(growable: false),\n'
              '    \'avatar_motion_summary_count\': motionSummaries.length,\n'
              '    \'avatar_semantic_crossings\': motionSummaries.fold<int>(\n'
              '      0,\n'
              '      (count, summary) =>\n'
              '          count + (_scopeInt(summary.scope, \'avatarSemanticCrossings\') ?? 0),\n'
              '    ),\n'
              '    \'avatar_motion_summary_scopes\': motionSummaries\n'
              '        .map((event) => event.scope ?? \'\')\n'
              '        .toList(growable: false),\n'
              '    \'diagnostic_stage_counts\': stageCounts,\n'
              '  };\n'
              '}\n'
              '\n'
              'String? _scopeField(String? scope, String key) {\n'
              '  if (scope == null || scope.isEmpty) return null;\n'
              '  return RegExp(\n'
              '    \'(?:^|\\\\s)${RegExp.escape(key)}=([^\\\\s]+)\',\n'
              '  ).firstMatch(scope)?.group(1);\n'
              '}\n'
              '\n'
              'int? _scopeInt(String? scope, String key) =>\n'
              '    int.tryParse(_scopeField(scope, key) ?? \'\');\n'
              '\n'
              'int _durationListDelta(\n'
              '  Map<String, Object?> before,\n'
              '  Map<String, Object?> after,\n'
              '  String key,\n'
              ') {\n'
              '  int sum(Object? value) => value is List\n'
              '      ? value.fold<int>(0, (total, item) => total + (item as num).toInt())\n'
              '      : 0;\n'
              '  return sum(after[key]) - sum(before[key]);\n'
              '}\n'
              '\n'
              'int _scalarDelta(\n'
              '  Map<String, Object?> before,\n'
              '  Map<String, Object?> after,\n'
              '  String key,\n'
              ') =>\n'
              '    ((after[key] as num?)?.toInt() ?? 0) -\n'
              '    ((before[key] as num?)?.toInt() ?? 0);\n'
              '\n'
              'void _expectEquivalentMotion(\n'
              '  Map<String, dynamic> first,\n'
              '  Map<String, dynamic> second, {\n'
              '  required String label,\n'
              '  bool requireNoSlowdown = false,\n'
              '}) {\n'
              '  expect(\n'
              '    second[\'rail_target_index\'],\n'
              '    first[\'rail_target_index\'],\n'
              '    reason: \'$label target drifted\',\n'
              '  );\n'
              '  expect(\n'
              '    second[\'rail_settle_index\'],\n'
              '    first[\'rail_settle_index\'],\n'
              '    reason: \'$label settle drifted\',\n'
              '  );\n'
              '  expect(\n'
              '    second[\'semantic_sequence\'],\n'
              '    first[\'semantic_sequence\'],\n'
              '    reason: \'$label semantic sequence drifted\',\n'
              '  );\n'
              '  final firstDuration = (first[\'motion_duration_micros\'] as num).toInt();\n'
              '  final secondDuration = (second[\'motion_duration_micros\'] as num).toInt();\n'
              '  final tolerance = math.max(32_000, (firstDuration * .15).round());\n'
              '  if (requireNoSlowdown) {\n'
              '    // The tenth fling runs after warmup. Its wall-clock duration can be\n'
              '    // shorter than the cold first fling without changing the rail simulation,\n'
              '    // which the exact target, settle, semantic and flight checks above cover.\n'
              '    // This lane is a regression gate, so reject only an actual slowdown.\n'
              '    expect(\n'
              '      secondDuration,\n'
              '      lessThanOrEqualTo(firstDuration + tolerance),\n'
              '      reason: \'$label duration regressed beyond tolerance\',\n'
              '    );\n'
              '  } else {\n'
              '    expect(\n'
              '      (secondDuration - firstDuration).abs(),\n'
              '      lessThanOrEqualTo(tolerance),\n'
              '      reason: \'$label duration exceeded tolerance\',\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'void _expectEquivalentRailFlight(\n'
              '  Map<String, dynamic> first,\n'
              '  Map<String, dynamic> second, {\n'
              '  required String label,\n'
              '}) {\n'
              '  final firstFlight = Map<String, Object?>.from(first[\'rail_flight\']! as Map);\n'
              '  final secondFlight = Map<String, Object?>.from(second[\'rail_flight\']! as Map);\n'
              '  double number(Map<String, Object?> source, String key) {\n'
              '    final value = source[key];\n'
              '    if (value is! num) fail(\'$label has no numeric rail_flight.$key\');\n'
              '    return value.toDouble();\n'
              '  }\n'
              '\n'
              '  double relativeDifference(String key) {\n'
              '    final left = number(firstFlight, key);\n'
              '    final right = number(secondFlight, key);\n'
              '    final denominator = math.max(left.abs(), right.abs());\n'
              '    return denominator == 0 ? 0 : (left - right).abs() / denominator;\n'
              '  }\n'
              '\n'
              '  expect(\n'
              '    relativeDifference(\'drag_end_velocity\'),\n'
              '    lessThanOrEqualTo(.02),\n'
              '    reason: \'$label drag-end velocity drifted\',\n'
              '  );\n'
              '  expect(\n'
              '    relativeDifference(\'ballistic_input_velocity\'),\n'
              '    lessThanOrEqualTo(.02),\n'
              '    reason: \'$label ballistic input drifted\',\n'
              '  );\n'
              '  final halfItemExtent = number(firstFlight, \'item_extent\') / 2;\n'
              '  expect(\n'
              '    (number(firstFlight, \'total_pixel_distance\') -\n'
              '            number(secondFlight, \'total_pixel_distance\'))\n'
              '        .abs(),\n'
              '    lessThanOrEqualTo(halfItemExtent),\n'
              '    reason: \'$label physical endpoint drifted\',\n'
              '  );\n'
              '  expect(\n'
              '    (number(firstFlight, \'logical_delta\') -\n'
              '            number(secondFlight, \'logical_delta\'))\n'
              '        .abs(),\n'
              '    lessThanOrEqualTo(1),\n'
              '    reason: \'$label semantic endpoint drifted\',\n'
              '  );\n'
              '  for (final flight in <Map<String, Object?>>[firstFlight, secondFlight]) {\n'
              '    for (final key in const <String>[\n'
              '      \'activity_interrupt_count\',\n'
              '      \'metric_change_count\',\n'
              '      \'root_rebuild_count\',\n'
              '      \'rail_rebuild_count\',\n'
              '      \'data_io_count\',\n'
              '      \'platform_call_count\',\n'
              '      \'sql_count\',\n'
              '    ]) {\n'
              '      expect(flight[key], 0, reason: \'$label rail_flight.$key\');\n'
              '    }\n'
              '    expect(\n'
              '      number(flight, \'log_viewport_rebuild_count\'),\n'
              '      lessThanOrEqualTo(\n'
              '        DashboardProfileReport.maximumLogViewportRebuildsPerFlight,\n'
              '      ),\n'
              '      reason:\n'
              '          \'$label rail_flight.log_viewport_rebuild_count must remain a \'\n'
              '          \'single structural bind, never a per-tick rebuild stream\',\n'
              '    );\n'
              '  }\n'
              '}\n'
              '\n'
              'Future<void> _prepareScenario(\n'
              '  WidgetTester tester,\n'
              '  DashboardCoreController controller,\n'
              '  _ProfileScenario scenario, {\n'
              '  required int expectedParentEntryCount,\n'
              '}) async {\n'
              '  expect(controller.navigation.state.plane, scenario.initialPlane);\n'
              '  expect(controller.navigation.state.isRailOpen, scenario.initialRailOpen);\n'
              '  expect(\n'
              '    controller.navigation.state.parentQueryScope.direction,\n'
              '    scenario.initialDirection,\n'
              '  );\n'
              '  expect(\n'
              '    controller.preparedIndex!\n'
              '        .frameFor(controller.navigation.state.parentQueryScope)\n'
              '        .entryCount,\n'
              '    expectedParentEntryCount,\n'
              '  );\n'
              '  if (scenario == _ProfileScenario.avatarFirstTarget) {\n'
              '    await _showBudgetAvatarRail(tester);\n'
              '  }\n'
              '  if (scenario == _ProfileScenario.tenthFling) {\n'
              '    for (var index = 0; index < 9; index += 1) {\n'
              '      await _resetRailToIndex(tester, controller, 13);\n'
              '      await _flingRail(tester, controller);\n'
              '    }\n'
              '    await _resetRailToIndex(tester, controller, 13);\n'
              '  }\n'
              '}\n'
              '\n'
              '/// Reaches Budget through the real production header gesture. This keeps the\n'
              '/// Avatar profile on the same persistent FluviApp/CoreDashboard composition as\n'
              '/// the Time matrix and deliberately does not install a category scene itself.\n'
              'Future<void> _showBudgetAvatarRail(WidgetTester tester) async {\n'
              '  await tester.drag(\n'
              '    find.byKey(const ValueKey(\'dashboard-core-mode-header-gesture-region\')),\n'
              '    const Offset(-260, 0),\n'
              '  );\n'
              '  final deadline = DateTime.now().add(const Duration(seconds: 8));\n'
              '  while (DateTime.now().isBefore(deadline)) {\n'
              '    await tester.pump();\n'
              '    final carousel = find.byKey(\n'
              '      const ValueKey(\'budget-target-avatar-carousel\'),\n'
              '    );\n'
              '    if (carousel.evaluate().length == 1 &&\n'
              '        find\n'
              '                .descendant(of: carousel, matching: find.byType(ListView))\n'
              '                .evaluate()\n'
              '                .length ==\n'
              '            1) {\n'
              '      return;\n'
              '    }\n'
              '    await Future<void>.delayed(const Duration(milliseconds: 16));\n'
              '  }\n'
              '  fail(\'Budget Avatar rail did not mount after the real header mode gesture.\');\n'
              '}\n'
              '\n'
              'Future<void> _resetRailToIndex(\n'
              '  WidgetTester tester,\n'
              '  DashboardCoreController controller,\n'
              '  int logicalIndex,\n'
              ') async {\n'
              '  await _waitForMotionIdle(controller);\n'
              '  await tester.pump();\n'
              '  final catalog = controller.motion.catalog;\n'
              '  final entry = catalog.entryAtLogicalIndex(logicalIndex);\n'
              '  controller.motion.carouselController.jumpToIndex(logicalIndex);\n'
              '  await _waitForVisibleReset(tester, controller, entry);\n'
              '  final visiblePublishCount = controller.visibleFrames.visiblePublishCount;\n'
              '  final visualDigest = controller.visibleFrames.value?.visualDigest;\n'
              '  controller.settleRail(logicalIndex);\n'
              '  await tester.pump();\n'
              '\n'
              '  expect(controller.visibleFrames.visiblePublishCount, visiblePublishCount);\n'
              '  expect(controller.visibleFrames.value?.visualDigest, visualDigest);\n'
              '  expect(controller.motion.state.semanticIndex, entry.logicalIndex);\n'
              '  expect(\n'
              '    controller.visibleFrames.value?.semanticChildIndex,\n'
              '    entry.logicalIndex,\n'
              '  );\n'
              '  expect(controller.visibleFrames.value?.queryKey, entry.queryKey);\n'
              '}\n'
              '\n'
              'Future<void> _waitForVisibleReset(\n'
              '  WidgetTester tester,\n'
              '  DashboardCoreController controller,\n'
              '  DashboardSemanticEntry entry,\n'
              ') async {\n'
              '  final deadline = DateTime.now().add(const Duration(seconds: 8));\n'
              '  var consecutiveReadySamples = 0;\n'
              '  while (DateTime.now().isBefore(deadline)) {\n'
              '    await tester.pump();\n'
              '    final visible = controller.visibleFrames.value;\n'
              '    final isReady =\n'
              '        controller.motion.state.semanticIndex == entry.logicalIndex &&\n'
              '        visible?.semanticChildIndex == entry.logicalIndex &&\n'
              '        visible?.queryKey == entry.queryKey &&\n'
              '        !controller.frameCoalescer.hasPendingTarget;\n'
              '    if (isReady) {\n'
              '      consecutiveReadySamples += 1;\n'
              '      if (consecutiveReadySamples >= 3) return;\n'
              '    } else {\n'
              '      consecutiveReadySamples = 0;\n'
              '    }\n'
              '    await Future<void>.delayed(const Duration(milliseconds: 16));\n'
              '  }\n'
              '  fail(\n'
              '    \'Dashboard rail reset did not reach one coherent visible display frame: \'\n'
              '    \'motion=${controller.motion.state.semanticIndex} \'\n'
              '    \'visible=${controller.visibleFrames.value?.semanticChildIndex} \'\n'
              '    \'target=${entry.logicalIndex} \'\n'
              '    \'pending=${controller.frameCoalescer.hasPendingTarget}.\',\n'
              '  );\n'
              '}\n'
              '\n'
              'Future<void> _runMeasuredScenario(\n'
              '  WidgetTester tester,\n'
              '  DashboardCoreController controller,\n'
              '  _ProfileScenario scenario, {\n'
              '  required List<DashboardAvatarTargetPainted> avatarPaints,\n'
              '  required bool Function() avatarMotionLaneObserved,\n'
              '  required List<Map<String, Object?>> avatarFlights,\n'
              '  required List<FluviDiagnosticEvent> avatarEvents,\n'
              '  required Map<String, Object?> avatarFixture,\n'
              '  required int Function() timeInteractionCount,\n'
              '  required ValueChanged<Map<String, Object?>> onAvatarEvidence,\n'
              '}) async {\n'
              '  switch (scenario) {\n'
              '    case _ProfileScenario.avatarFirstTarget:\n'
              '      // One persistent production composition. Alternating real pointers\n'
              '      // exercise both directions; each flight must finish exactly before the\n'
              '      // next starts, so a later fling cannot rescue an unresolved predecessor.\n'
              '      for (var flight = 0; flight < 4; flight++) {\n'
              '        final sequenceBefore = _lastDiagnosticSequence();\n'
              '        final paintCountBefore = avatarPaints.length;\n'
              '        await _flingBudgetAvatar(\n'
              '          tester,\n'
              '          controller,\n'
              '          offset: Offset(flight.isEven ? -420 : 420, 0),\n'
              '          avatarMotionLaneObserved: avatarMotionLaneObserved,\n'
              '        );\n'
              '        final evidence = await _waitForAvatarExactPaint(\n'
              '          tester,\n'
              '          controller,\n'
              '          avatarPaints,\n'
              '          paintCountBefore: paintCountBefore,\n'
              '          sequenceBefore: sequenceBefore,\n'
              '          fixture: avatarFixture,\n'
              '          timeInteractionCount: timeInteractionCount,\n'
              '          onEvidence: onAvatarEvidence,\n'
              '        );\n'
              '        DashboardProfileReport.validateAvatarFinalTargetEvidence(evidence);\n'
              '        avatarFlights.add(evidence);\n'
              '        avatarEvents.addAll(_diagnosticEventsAfter(sequenceBefore));\n'
              '      }\n'
              '    case _ProfileScenario.summaryPlane:\n'
              '      await _flingSummary(tester, const Offset(0, -180));\n'
              '      await _flingSummary(tester, const Offset(0, -180));\n'
              '    case _ProfileScenario.yearPopulated:\n'
              '    case _ProfileScenario.yearEmpty:\n'
              '    case _ProfileScenario.month94:\n'
              '    case _ProfileScenario.monthEmpty:\n'
              '      for (var index = 0; index < 10; index += 1) {\n'
              '        await _flingRail(tester, controller);\n'
              '      }\n'
              '    case _ProfileScenario.firstFling:\n'
              '    case _ProfileScenario.tenthFling:\n'
              '      await _flingRail(tester, controller);\n'
              '    case _ProfileScenario.parentWhileRailOpen:\n'
              '      await _flingSummary(tester, const Offset(-180, 0));\n'
              '    case _ProfileScenario.directionWhileRailOpen:\n'
              '      await tester.tap(find.byKey(const ValueKey(\'fluvi-expense-button\')));\n'
              '      await _settle(tester);\n'
              '      await tester.tap(find.byKey(const ValueKey(\'fluvi-income-button\')));\n'
              '      await _settle(tester);\n'
              '    case _ProfileScenario.pulseWithParentNavigation:\n'
              '      await tester.tap(find.byKey(const ValueKey(\'fluvi-income-button\')));\n'
              '      await tester.pump(const Duration(milliseconds: 16));\n'
              '      await tester.fling(\n'
              '        find.byKey(const ValueKey(\'dashboard-summary-shell-transform\')),\n'
              '        const Offset(-180, 0),\n'
              '        1200,\n'
              '      );\n'
              '      await _settle(tester);\n'
              '  }\n'
              '}\n'
              '\n'
              'Future<void> _flingBudgetAvatar(\n'
              '  WidgetTester tester,\n'
              '  DashboardCoreController controller, {\n'
              '  required Offset offset,\n'
              '  required bool Function() avatarMotionLaneObserved,\n'
              '}) async {\n'
              '  final carousel = find.byKey(const ValueKey(\'budget-target-avatar-carousel\'));\n'
              '  expect(carousel, findsOneWidget);\n'
              '  await tester.fling(carousel, offset, 2200);\n'
              '  await _waitForBudgetAvatarMotionEnd(\n'
              '    tester,\n'
              '    controller,\n'
              '    motionLaneObserved: avatarMotionLaneObserved,\n'
              '  );\n'
              '}\n'
              '\n'
              'Future<void> _waitForBudgetAvatarMotionEnd(\n'
              '  WidgetTester tester,\n'
              '  DashboardCoreController controller, {\n'
              '  required bool Function() motionLaneObserved,\n'
              '}) async {\n'
              '  final deadline = DateTime.now().add(const Duration(seconds: 8));\n'
              '  var consecutiveIdleSamples = 0;\n'
              '  while (DateTime.now().isBefore(deadline)) {\n'
              '    await tester.pump();\n'
              '    final active = controller.isMotionLaneActive(\n'
              '      DashboardMotionLane.budgetAvatar,\n'
              '    );\n'
              '    if (motionLaneObserved() && !active) {\n'
              '      consecutiveIdleSamples += 1;\n'
              '      if (consecutiveIdleSamples >= 3) return;\n'
              '    } else {\n'
              '      consecutiveIdleSamples = 0;\n'
              '    }\n'
              '    await Future<void>.delayed(const Duration(milliseconds: 16));\n'
              '  }\n'
              '  fail(\n'
              '    \'Budget Avatar motion did not complete: \'\n'
              '    \'motionLaneObserved=${motionLaneObserved()} \'\n'
              '    \'active=${controller.isMotionLaneActive(DashboardMotionLane.budgetAvatar)}.\',\n'
              '  );\n'
              '}\n'
              '\n'
              'Future<Map<String, Object?>> _waitForAvatarExactPaint(\n'
              '  WidgetTester tester,\n'
              '  DashboardCoreController controller,\n'
              '  List<DashboardAvatarTargetPainted> avatarPaints, {\n'
              '  required int paintCountBefore,\n'
              '  required int sequenceBefore,\n'
              '  required Map<String, Object?> fixture,\n'
              '  required int Function() timeInteractionCount,\n'
              '  required ValueChanged<Map<String, Object?>> onEvidence,\n'
              '}) async {\n'
              '  final deadline = DateTime.now().add(const Duration(seconds: 8));\n'
              '  Map<String, Object?>? evidence;\n'
              '  while (DateTime.now().isBefore(deadline)) {\n'
              '    await tester.pump();\n'
              '    evidence = _avatarFinalTargetEvidence(\n'
              '      tester,\n'
              '      controller,\n'
              '      paints: avatarPaints.sublist(paintCountBefore),\n'
              '      events: _diagnosticEventsAfter(sequenceBefore),\n'
              '      fixture: fixture,\n'
              '      timeInteractionCount: timeInteractionCount(),\n'
              '    );\n'
              '    try {\n'
              '      DashboardProfileReport.validateAvatarFinalTargetEvidence(evidence);\n'
              '      evidence[\'flight_start_sequence\'] = sequenceBefore;\n'
              '      evidence[\'flight_start_paint_count\'] = paintCountBefore;\n'
              '      onEvidence(evidence);\n'
              '      return evidence;\n'
              '    } on StateError {\n'
              '      // This is a bounded test completion window; production owns readiness.\n'
              '    }\n'
              '    await Future<void>.delayed(const Duration(milliseconds: 16));\n'
              '  }\n'
              '  if (evidence != null) onEvidence(evidence);\n'
              '  fail(\'Avatar final target did not bind, paint and canonicalize: $evidence\');\n'
              '}\n'
              '\n'
              'Map<String, Object?> _verifyAvatarNonemptyFixture(\n'
              '  WidgetTester tester,\n'
